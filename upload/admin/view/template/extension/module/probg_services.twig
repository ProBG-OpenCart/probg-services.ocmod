{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-probg-services" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button><a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <ul class="nav nav-tabs"><li class="active"><a href="{{ settings_url }}">{{ text_settings }}</a></li><li><a href="{{ categories_url }}">{{ text_categories }}</a></li><li><a href="{{ services_url }}">{{ text_services }}</a></li><li><a href="{{ enquiries_url }}">{{ text_enquiries }}</a></li></ul>
    <div class="row">
      <div class="col-sm-4"><div class="tile"><div class="tile-heading">{{ text_categories }}</div><div class="tile-body"><i class="fa fa-folder-open"></i><h2 class="pull-right">{{ total_categories }}</h2></div><div class="tile-footer"><a href="{{ categories_url }}">{{ button_categories }}</a></div></div></div>
      <div class="col-sm-4"><div class="tile"><div class="tile-heading">{{ text_services }}</div><div class="tile-body"><i class="fa fa-briefcase"></i><h2 class="pull-right">{{ total_services }}</h2></div><div class="tile-footer"><a href="{{ services_url }}">{{ button_services }}</a></div></div></div>
      <div class="col-sm-4"><div class="tile"><div class="tile-heading">{{ text_enquiries }}</div><div class="tile-body"><i class="fa fa-envelope"></i><h2 class="pull-right">{{ total_enquiries }}</h2></div><div class="tile-footer"><a href="{{ enquiries_url }}">{{ text_enquiries }}</a></div></div></div>
    </div>
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div><div class="panel-body">
      <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_stage_info }} &nbsp; <strong>{{ text_version }}:</strong> {{ version }} &nbsp; <strong>{{ text_stage }}:</strong> {{ stage }}</div>
      <form action="{{ action }}" method="post" id="form-probg-services" class="form-horizontal">
        <ul class="nav nav-tabs"><li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li><li><a href="#tab-integrations" data-toggle="tab">{{ tab_integrations }}</a></li><li><a href="#tab-features" data-toggle="tab">{{ tab_features }}</a></li></ul>
        <div class="tab-content">
          <div class="tab-pane active" id="tab-general">
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="module_probg_services_status" class="form-control"><option value="1"{% if module_probg_services_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_services_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
            <div class="form-group{% if error_limit %} has-error{% endif %}"><label class="col-sm-2 control-label">{{ entry_limit }}</label><div class="col-sm-10"><input type="number" min="1" max="100" name="module_probg_services_limit" value="{{ module_probg_services_limit }}" class="form-control">{% if error_limit %}<div class="text-danger">{{ error_limit }}</div>{% endif %}</div></div>
          </div>
          <div class="tab-pane" id="tab-integrations">
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_sitemap }}</label><div class="col-sm-10"><select name="module_probg_services_sitemap" class="form-control"><option value="1"{% if module_probg_services_sitemap %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_services_sitemap %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_cache_status }}</label><div class="col-sm-10"><select name="module_probg_services_cache_status" class="form-control"><option value="1"{% if module_probg_services_cache_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_services_cache_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
          </div>
          <div class="tab-pane" id="tab-features"><h4>{{ text_completed }}</h4><ul><li>{{ feature_structure }}</li><li>{{ feature_database }}</li><li>{{ feature_permissions }}</li><li>{{ feature_languages }}</li><li>{{ feature_documentation }}</li><li>{{ feature_opencart4 }}</li></ul><h4>{{ text_next_stage }}</h4><p>{{ text_next_stage_description }}</p></div>
        </div>
      </form>
    </div></div>
  </div>
</div>
{{ footer }}
