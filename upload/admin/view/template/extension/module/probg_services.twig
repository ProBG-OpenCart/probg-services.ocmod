{{ header }}{{ column_left }}
<div id="content"><div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-probg-services" class="btn btn-primary"><i class="fa fa-save"></i></button><a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
<div class="container-fluid">{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
<ul class="nav nav-tabs"><li class="active"><a href="{{ settings_url }}">{{ text_settings }}</a></li><li><a href="{{ categories_url }}">{{ text_categories }}</a></li><li><a href="{{ services_url }}">{{ text_services }}</a></li><li><a href="{{ enquiries_url }}">{{ text_enquiries }}</a></li></ul>
<div class="row"><div class="col-sm-4"><div class="tile"><div class="tile-heading">{{ text_categories }}</div><div class="tile-body"><i class="fa fa-folder-open"></i><h2 class="pull-right">{{ total_categories }}</h2></div></div></div><div class="col-sm-4"><div class="tile"><div class="tile-heading">{{ text_services }}</div><div class="tile-body"><i class="fa fa-briefcase"></i><h2 class="pull-right">{{ total_services }}</h2></div></div></div><div class="col-sm-4"><div class="tile"><div class="tile-heading">{{ text_enquiries }}</div><div class="tile-body"><i class="fa fa-envelope"></i><h2 class="pull-right">{{ total_enquiries }}</h2></div></div></div></div>
<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div><div class="panel-body"><div class="alert alert-info">{{ text_stage_info }} <strong>{{ text_version }}:</strong> {{ version }} <strong>{{ text_stage }}:</strong> {{ stage }}</div>
<form action="{{ action }}" method="post" id="form-probg-services" class="form-horizontal"><ul class="nav nav-tabs"><li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li><li><a href="#tab-seo" data-toggle="tab">{{ tab_seo }}</a></li><li><a href="#tab-provider" data-toggle="tab">{{ tab_provider }}</a></li><li><a href="#tab-integrations" data-toggle="tab">{{ tab_integrations }}</a></li><li><a href="#tab-features" data-toggle="tab">{{ tab_features }}</a></li></ul><div class="tab-content">
<div class="tab-pane active" id="tab-general"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="module_probg_services_status" class="form-control"><option value="1"{% if module_probg_services_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_services_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div><div class="form-group{% if error_limit %} has-error{% endif %}"><label class="col-sm-2 control-label">{{ entry_limit }}</label><div class="col-sm-10"><input type="number" min="1" max="100" name="module_probg_services_limit" value="{{ module_probg_services_limit }}" class="form-control">{% if error_limit %}<div class="text-danger">{{ error_limit }}</div>{% endif %}</div></div></div>
<div class="tab-pane" id="tab-seo"><ul class="nav nav-tabs" id="seo-language">{% for language in languages %}<li><a href="#seo-language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png"> {{ language.name }}</a></li>{% endfor %}</ul><div class="tab-content">{% for language in languages %}{% set d=module_probg_services_description[language.language_id] ?? {} %}<div class="tab-pane" id="seo-language{{ language.language_id }}"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_section_title }}</label><div class="col-sm-10"><input name="module_probg_services_description[{{ language.language_id }}][title]" value="{{ d.title ?? '' }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_section_description }}</label><div class="col-sm-10"><textarea name="module_probg_services_description[{{ language.language_id }}][description]" data-toggle="summernote" class="form-control">{{ d.description ?? '' }}</textarea></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_title }}</label><div class="col-sm-10"><input name="module_probg_services_description[{{ language.language_id }}][meta_title]" value="{{ d.meta_title ?? '' }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_description }}</label><div class="col-sm-10"><textarea name="module_probg_services_description[{{ language.language_id }}][meta_description]" class="form-control">{{ d.meta_description ?? '' }}</textarea></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_keyword }}</label><div class="col-sm-10"><input name="module_probg_services_description[{{ language.language_id }}][meta_keyword]" value="{{ d.meta_keyword ?? '' }}" class="form-control"></div></div></div>{% endfor %}</div></div>
<div class="tab-pane" id="tab-provider"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_provider_name }}</label><div class="col-sm-10"><input name="module_probg_services_provider_name" value="{{ module_probg_services_provider_name }}" class="form-control"><p class="help-block">{{ help_provider_name }}</p></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_provider_url }}</label><div class="col-sm-10"><input name="module_probg_services_provider_url" value="{{ module_probg_services_provider_url }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_provider_logo }}</label><div class="col-sm-10"><input name="module_probg_services_provider_logo" value="{{ module_probg_services_provider_logo }}" class="form-control"><p class="help-block">{{ help_provider_logo }}</p></div></div></div>
<div class="tab-pane" id="tab-integrations"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_sitemap }}</label><div class="col-sm-10"><select name="module_probg_services_sitemap" class="form-control"><option value="1"{% if module_probg_services_sitemap %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_services_sitemap %} selected{% endif %}>{{ text_disabled }}</option></select></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_sitemap_changefreq }}</label><div class="col-sm-10"><select name="module_probg_services_sitemap_changefreq" class="form-control">{% for f in ['always','hourly','daily','weekly','monthly','yearly','never'] %}<option value="{{ f }}"{% if module_probg_services_sitemap_changefreq == f %} selected{% endif %}>{{ f }}</option>{% endfor %}</select></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_priority_section }}</label><div class="col-sm-10"><input type="number" step="0.1" min="0" max="1" name="module_probg_services_sitemap_priority_section" value="{{ module_probg_services_sitemap_priority_section }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_priority_category }}</label><div class="col-sm-10"><input type="number" step="0.1" min="0" max="1" name="module_probg_services_sitemap_priority_category" value="{{ module_probg_services_sitemap_priority_category }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_priority_service }}</label><div class="col-sm-10"><input type="number" step="0.1" min="0" max="1" name="module_probg_services_sitemap_priority_service" value="{{ module_probg_services_sitemap_priority_service }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_cache_status }}</label><div class="col-sm-10"><select name="module_probg_services_cache_status" class="form-control"><option value="1"{% if module_probg_services_cache_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_services_cache_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div></div>
<div class="tab-pane" id="tab-features"><h4>{{ text_completed }}</h4><ul><li>{{ feature_structure }}</li><li>{{ feature_database }}</li><li>{{ feature_permissions }}</li><li>{{ feature_languages }}</li><li>{{ feature_documentation }}</li><li>{{ feature_opencart4 }}</li></ul><h4>{{ text_next_stage }}</h4><p>{{ text_next_stage_description }}</p></div>
</div></form></div></div></div></div>
<link href="view/javascript/summernote/summernote.css" rel="stylesheet"><script src="view/javascript/summernote/summernote.js"></script><script src="view/javascript/summernote/opencart.js"></script><script>$('#seo-language a:first').tab('show');</script>{{ footer }}