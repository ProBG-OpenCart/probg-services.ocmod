{{ header }}{{ column_left }}
<div id="content"><div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-module" class="btn btn-primary"><i class="fa fa-save"></i></button> <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
<div class="container-fluid">{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div><div class="panel-body"><form action="{{ action }}" method="post" id="form-module" class="form-horizontal">
<div class="form-group required"><label class="col-sm-2 control-label">{{ entry_name }}</label><div class="col-sm-10"><input name="name" value="{{ name }}" class="form-control">{% if error_name %}<div class="text-danger">{{ error_name }}</div>{% endif %}</div></div>
<div class="form-group"><label class="col-sm-2 control-label">{{ entry_title }}</label><div class="col-sm-10">{% for language in languages %}<div class="input-group"><span class="input-group-addon">{{ language.name }}</span><input name="block_description[{{ language.language_id }}][title]" value="{{ block_description[language.language_id].title ?? '' }}" class="form-control"></div>{% endfor %}</div></div>
<div class="form-group"><label class="col-sm-2 control-label">{{ entry_mode }}</label><div class="col-sm-10"><select name="mode" id="input-mode" class="form-control"><option value="latest"{% if mode == 'latest' %} selected{% endif %}>{{ text_latest }}</option><option value="category"{% if mode == 'category' %} selected{% endif %}>{{ text_category }}</option><option value="featured"{% if mode == 'featured' %} selected{% endif %}>{{ text_featured }}</option></select></div></div>
<div class="form-group" id="row-category"><label class="col-sm-2 control-label">{{ entry_category }}</label><div class="col-sm-10"><select name="category_id" class="form-control"><option value="0">---</option>{% for category in categories %}<option value="{{ category.category_id }}"{% if category.category_id == category_id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></div></div>
<div class="form-group" id="row-services"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_services }}">{{ entry_services }}</span></label><div class="col-sm-10"><input id="input-service" class="form-control"><div id="service-selected" class="well well-sm" style="height:150px;overflow:auto">{% for service in selected_services %}<div id="service-selected{{ service.service_id }}"><i class="fa fa-minus-circle"></i> {{ service.name }}<input type="hidden" name="service_ids[]" value="{{ service.service_id }}"></div>{% endfor %}</div></div></div>
<div class="form-group required"><label class="col-sm-2 control-label">{{ entry_limit }}</label><div class="col-sm-10"><input type="number" name="limit" value="{{ limit }}" min="1" max="100" class="form-control">{% if error_limit %}<div class="text-danger">{{ error_limit }}</div>{% endif %}</div></div>
<div class="form-group"><label class="col-sm-2 control-label">{{ entry_width }}</label><div class="col-sm-10"><input type="number" name="width" value="{{ width }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_height }}</label><div class="col-sm-10"><input type="number" name="height" value="{{ height }}" class="form-control"></div></div>
<div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="status" class="form-control"><option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
</form></div></div></div></div>
<script>function toggleRows(){var m=$('#input-mode').val();$('#row-category').toggle(m==='category');$('#row-services').toggle(m==='featured');}$('#input-mode').on('change',toggleRows);toggleRows();$('#input-service').autocomplete({source:function(request,response){$.ajax({url:'index.php?route=extension/probg_services/service/autocomplete&user_token={{ user_token }}&filter_name='+encodeURIComponent(request),dataType:'json',success:function(json){response($.map(json,function(item){return {label:item.name,value:item.service_id};}));}});},select:function(item){$('#input-service').val('');$('#service-selected'+item.value).remove();$('#service-selected').append('<div id="service-selected'+item.value+'"><i class="fa fa-minus-circle"></i> '+item.label+'<input type="hidden" name="service_ids[]" value="'+item.value+'"></div>');}});$('#service-selected').on('click','.fa-minus-circle',function(){$(this).parent().remove();});</script>{{ footer }}