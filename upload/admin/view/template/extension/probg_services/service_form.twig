{{ header }}{{ column_left }}
<div id="content"><div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-service" class="btn btn-primary"><i class="fa fa-save"></i></button> <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div><div class="container-fluid">{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
<ul class="nav nav-tabs"><li><a href="{{ settings_url }}">{{ tab_settings }}</a></li><li><a href="{{ categories_url }}">{{ tab_categories }}</a></li><li class="active"><a href="{{ services_url }}">{{ tab_services }}</a></li></ul>
<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3></div><div class="panel-body"><form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-service" class="form-horizontal">
<ul class="nav nav-tabs"><li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li><li><a href="#tab-data" data-toggle="tab">{{ tab_data }}</a></li><li><a href="#tab-gallery" data-toggle="tab">{{ tab_gallery }}</a></li><li><a href="#tab-links" data-toggle="tab">{{ tab_links }}</a></li><li><a href="#tab-seo" data-toggle="tab">{{ tab_seo }}</a></li></ul><div class="tab-content">
<div class="tab-pane active" id="tab-general"><ul class="nav nav-tabs" id="language">{% for language in languages %}<li><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png"> {{ language.name }}</a></li>{% endfor %}</ul><div class="tab-content">{% for language in languages %}{% set d=service_description[language.language_id] ?? {} %}<div class="tab-pane" id="language{{ language.language_id }}"><div class="form-group required"><label class="col-sm-2 control-label">{{ entry_name }}</label><div class="col-sm-10"><input name="service_description[{{ language.language_id }}][name]" value="{{ d.name ?? '' }}" class="form-control">{% if error_name[language.language_id] %}<div class="text-danger">{{ error_name[language.language_id] }}</div>{% endif %}</div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_subtitle }}</label><div class="col-sm-10"><input name="service_description[{{ language.language_id }}][subtitle]" value="{{ d.subtitle ?? '' }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_description_short }}</label><div class="col-sm-10"><textarea name="service_description[{{ language.language_id }}][description_short]" rows="4" class="form-control">{{ d.description_short ?? '' }}</textarea></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_description }}</label><div class="col-sm-10"><textarea name="service_description[{{ language.language_id }}][description]" data-toggle="summernote" class="form-control">{{ d.description ?? '' }}</textarea></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_price_text }}</label><div class="col-sm-10"><input name="service_description[{{ language.language_id }}][price_text]" value="{{ d.price_text ?? '' }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_button_text }}</label><div class="col-sm-10"><input name="service_description[{{ language.language_id }}][button_text]" value="{{ d.button_text ?? '' }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_title }}</label><div class="col-sm-10"><input name="service_description[{{ language.language_id }}][meta_title]" value="{{ d.meta_title ?? '' }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_description }}</label><div class="col-sm-10"><textarea name="service_description[{{ language.language_id }}][meta_description]" rows="3" class="form-control">{{ d.meta_description ?? '' }}</textarea></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_keyword }}</label><div class="col-sm-10"><textarea name="service_description[{{ language.language_id }}][meta_keyword]" rows="2" class="form-control">{{ d.meta_keyword ?? '' }}</textarea></div></div></div>{% endfor %}</div></div>
<div class="tab-pane" id="tab-data"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_category }}</label><div class="col-sm-10"><select name="category_id" class="form-control"><option value="0">{{ text_none }}</option>{% for category in categories %}<option value="{{ category.category_id }}"{% if category.category_id == category_id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_image }}</label><div class="col-sm-10"><a id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" data-placeholder="{{ placeholder }}"></a><input type="hidden" name="image" value="{{ image }}" id="input-image"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_social_image }}</label><div class="col-sm-10"><a id="thumb-social" data-toggle="image" class="img-thumbnail"><img src="{{ social_thumb }}" data-placeholder="{{ placeholder }}"></a><input type="hidden" name="social_image" value="{{ social_image }}" id="input-social"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_price }}</label><div class="col-sm-10"><input type="number" step="0.0001" name="price" value="{{ price }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_show_price }}</label><div class="col-sm-10"><select name="show_price" class="form-control"><option value="1"{% if show_price %} selected{% endif %}>{{ text_yes }}</option><option value="0"{% if not show_price %} selected{% endif %}>{{ text_no }}</option></select></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_enquiry_status }}</label><div class="col-sm-10"><select name="enquiry_status" class="form-control"><option value="1"{% if enquiry_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not enquiry_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_store }}</label><div class="col-sm-10"><div class="well well-sm"><label><input type="checkbox" name="service_store[]" value="0"{% if 0 in service_store %} checked{% endif %}> {{ text_default }}</label>{% for store in stores %}<br><label><input type="checkbox" name="service_store[]" value="{{ store.store_id }}"{% if store.store_id in service_store %} checked{% endif %}> {{ store.name }}</label>{% endfor %}</div></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_date_available }}</label><div class="col-sm-10"><input type="date" name="date_available" value="{{ date_available }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_sort_order }}</label><div class="col-sm-10"><input type="number" name="sort_order" value="{{ sort_order }}" class="form-control"></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="status" class="form-control"><option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div></div>
<div class="tab-pane" id="tab-gallery"><table id="images" class="table table-bordered"><thead><tr><td>{{ entry_image }}</td><td>{{ entry_sort_order }}</td><td></td></tr></thead><tbody>{% set image_row=0 %}{% for image in service_image %}<tr id="image-row{{ image_row }}"><td><a data-toggle="image" class="img-thumbnail"><img src="{{ image.thumb }}" data-placeholder="{{ placeholder }}"></a><input type="hidden" name="service_image[{{ image_row }}][image]" value="{{ image.image }}"></td><td><input type="number" name="service_image[{{ image_row }}][sort_order]" value="{{ image.sort_order }}" class="form-control"></td><td><button type="button" onclick="document.getElementById('image-row{{ image_row }}').remove();" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td></tr>{% set image_row=image_row+1 %}{% endfor %}</tbody><tfoot><tr><td colspan="2"></td><td><button type="button" id="button-image" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td></tr></tfoot></table></div>
<div class="tab-pane" id="tab-links"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_related }}</label><div class="col-sm-10"><input id="input-related" class="form-control"><div id="service-related" class="well well-sm" style="height:150px;overflow:auto">{% for related in related_services %}<div id="service-related{{ related.service_id }}"><i class="fa fa-minus-circle"></i> {{ related.name }}<input type="hidden" name="service_related[]" value="{{ related.service_id }}"></div>{% endfor %}</div></div></div></div>
<div class="tab-pane" id="tab-seo"><div class="alert alert-info">{{ help_keyword }}</div><table class="table table-bordered"><thead><tr><td>{{ entry_store }}</td><td>{{ entry_keyword }}</td></tr></thead><tbody>{% set allstores=[{store_id:0,name:text_default}]|merge(stores) %}{% for store in allstores %}<tr><td>{{ store.name }}</td><td>{% for language in languages %}<div class="input-group"><span class="input-group-addon">{{ language.name }}</span><input name="service_seo_url[{{ store.store_id }}][{{ language.language_id }}]" value="{{ service_seo_url[store.store_id][language.language_id] ?? '' }}" class="form-control"></div>{% if error_keyword[store.store_id][language.language_id] %}<div class="text-danger">{{ error_keyword[store.store_id][language.language_id] }}</div>{% endif %}{% endfor %}</td></tr>{% endfor %}</tbody></table></div>
</div></form></div></div></div></div>
<link href="view/javascript/summernote/summernote.css" rel="stylesheet"><script src="view/javascript/summernote/summernote.js"></script><script src="view/javascript/summernote/opencart.js"></script>
<script>$('#language a:first').tab('show');var image_row={{ image_row }};$('#button-image').on('click',function(){var h='<tr id="image-row'+image_row+'"><td><a data-toggle="image" class="img-thumbnail"><img src="{{ placeholder }}" data-placeholder="{{ placeholder }}"></a><input type="hidden" name="service_image['+image_row+'][image]" value=""></td><td><input type="number" name="service_image['+image_row+'][sort_order]" value="0" class="form-control"></td><td><button type="button" onclick="document.getElementById(\'image-row'+image_row+'\').remove();" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td></tr>';$('#images tbody').append(h);image_row++;});$('input#input-related').autocomplete({source:function(request,response){$.ajax({url:'index.php?route=extension/probg_services/service/autocomplete&user_token={{ user_token }}&filter_name='+encodeURIComponent(request),dataType:'json',success:function(json){response($.map(json,function(item){return {label:item.name,value:item.service_id};}));}});},select:function(item){$('#input-related').val('');$('#service-related'+item.value).remove();$('#service-related').append('<div id="service-related'+item.value+'"><i class="fa fa-minus-circle"></i> '+item.label+'<input type="hidden" name="service_related[]" value="'+item.value+'"></div>');}});$('#service-related').on('click','.fa-minus-circle',function(){$(this).parent().remove();});</script>{{ footer }}