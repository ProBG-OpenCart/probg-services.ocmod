{{ header }}{{ column_left }}
<div id="content"><div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="button" class="btn btn-danger" onclick="if(confirm('{{ text_confirm }}')) document.getElementById('form-enquiry').submit();"><i class="fa fa-trash-o"></i></button></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
<div class="container-fluid">{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
<ul class="nav nav-tabs"><li><a href="{{ settings_url }}">{{ text_settings }}</a></li><li><a href="{{ categories_url }}">{{ text_categories }}</a></li><li><a href="{{ services_url }}">{{ text_services }}</a></li><li class="active"><a href="{{ enquiries_url }}">{{ text_enquiries }}</a></li></ul>
<div class="row"><div class="col-md-3 col-md-push-9"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ button_filter }}</h3></div><div class="panel-body"><div class="form-group"><label>{{ entry_filter_name }}</label><input id="f-name" value="{{ filter_name }}" class="form-control"></div><div class="form-group"><label>{{ entry_filter_email }}</label><input id="f-email" value="{{ filter_email }}" class="form-control"></div><div class="form-group"><label>{{ entry_filter_service_id }}</label><input id="f-service" value="{{ filter_service_id }}" class="form-control"></div><div class="form-group"><label>{{ entry_filter_status }}</label><select id="f-status" class="form-control"><option value=""></option>{% for status in statuses %}<option value="{{ status.status_id }}"{% if filter_status_id == status.status_id %} selected{% endif %}>{{ status.name }}</option>{% endfor %}</select></div><div class="form-group"><label>{{ entry_filter_assigned_user }}</label><select id="f-user" class="form-control"><option value=""></option><option value="0"{% if filter_assigned_user_id == '0' %} selected{% endif %}>{{ text_unassigned }}</option>{% for user in users %}<option value="{{ user.user_id }}"{% if filter_assigned_user_id == user.user_id %} selected{% endif %}>{{ user.firstname }} {{ user.lastname }}</option>{% endfor %}</select></div><div class="form-group"><label>{{ entry_filter_date_from }}</label><input type="date" id="f-from" value="{{ filter_date_from }}" class="form-control"></div><div class="form-group"><label>{{ entry_filter_date_to }}</label><input type="date" id="f-to" value="{{ filter_date_to }}" class="form-control"></div><button type="button" id="button-filter" class="btn btn-default pull-right">{{ button_filter }}</button></div></div></div>
<div class="col-md-9 col-md-pull-3"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-envelope"></i> {{ text_list }}</h3></div><div class="panel-body"><form action="{{ delete }}" method="post" id="form-enquiry"><div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td></td><td>{{ column_id }}</td><td>{{ column_customer }}</td><td>{{ column_email }}</td><td>{{ column_service }}</td><td>{{ column_status }}</td><td>{{ column_assigned_user }}</td><td>{{ column_date_added }}</td><td></td></tr></thead><tbody>{% if enquiries %}{% for enquiry in enquiries %}<tr><td><input type="checkbox" name="selected[]" value="{{ enquiry.enquiry_id }}"></td><td>#{{ enquiry.enquiry_id }}</td><td>{{ enquiry.name }}</td><td>{{ enquiry.email }}</td><td>{{ enquiry.service_name }}</td><td>{{ enquiry.status_name }}</td><td>{{ enquiry.assigned_user ?: text_unassigned }}</td><td>{{ enquiry.date_added }}</td><td class="text-right"><a href="{{ enquiry.view }}" class="btn btn-primary"><i class="fa fa-eye"></i></a></td></tr>{% endfor %}{% else %}<tr><td colspan="9" class="text-center">{{ text_no_results }}</td></tr>{% endif %}</tbody></table></div></form><div class="row"><div class="col-sm-6">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div></div></div></div></div></div></div>
<script>document.getElementById('button-filter').onclick=function(){var u='index.php?route=extension/probg_services/enquiry&user_token={{ user_token }}',m={'filter_name':'f-name','filter_email':'f-email','filter_service_id':'f-service','filter_status_id':'f-status','filter_assigned_user_id':'f-user','filter_date_from':'f-from','filter_date_to':'f-to'};Object.keys(m).forEach(function(k){var v=document.getElementById(m[k]).value;if(v!=='')u+='&'+k+'='+encodeURIComponent(v);});location.href=u;};</script>{{ footer }}