{{ header }}{{ column_left }}
<div id="content">
<div class="page-header"><div class="container-fluid"><div class="pull-right"><a href="{{ add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a><button type="button" class="btn btn-danger" onclick="if (confirm('{{ text_confirm }}')) { document.getElementById('form-service').submit(); }"><i class="fa fa-trash-o"></i></button></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
<div class="container-fluid">{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
<ul class="nav nav-tabs"><li><a href="{{ settings_url }}">{{ tab_settings }}</a></li><li><a href="{{ categories_url }}">{{ tab_categories }}</a></li><li class="active"><a href="{{ services_url }}">{{ tab_services }}</a></li></ul>
<div class="row"><div class="col-md-3 col-md-push-9"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ button_filter }}</h3></div><div class="panel-body"><div class="form-group"><label>{{ entry_filter_name }}</label><input id="filter-name" value="{{ filter_name }}" class="form-control"></div><div class="form-group"><label>{{ entry_filter_category }}</label><select id="filter-category" class="form-control"><option value=""></option>{% for category in categories %}<option value="{{ category.category_id }}"{% if filter_category_id == category.category_id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></div><div class="form-group"><label>{{ entry_filter_status }}</label><select id="filter-status" class="form-control"><option value=""></option><option value="1"{% if filter_status == '1' %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if filter_status == '0' %} selected{% endif %}>{{ text_disabled }}</option></select></div><button type="button" id="button-filter" class="btn btn-default pull-right"><i class="fa fa-filter"></i> {{ button_filter }}</button></div></div></div>
<div class="col-md-9 col-md-pull-3"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3></div><div class="panel-body"><form action="{{ delete }}" method="post" id="form-service"><div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td></td><td>{{ column_name }}</td><td>{{ column_category }}</td><td class="text-right">{{ column_price }}</td><td class="text-right">{{ column_sort_order }}</td><td>{{ column_status }}</td><td></td></tr></thead><tbody>{% if services %}{% for service in services %}<tr><td><input type="checkbox" name="selected[]" value="{{ service.service_id }}"></td><td>{{ service.name }}</td><td>{{ service.category_name ?: text_none }}</td><td class="text-right">{{ service.show_price ? service.price : '-' }}</td><td class="text-right">{{ service.sort_order }}</td><td>{{ service.status ? text_enabled : text_disabled }}</td><td class="text-right"><a href="{{ service.edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td></tr>{% endfor %}{% else %}<tr><td colspan="7" class="text-center">{{ text_no_results }}</td></tr>{% endif %}</tbody></table></div></form><div class="row"><div class="col-sm-6">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div></div></div></div></div></div></div>
<script>document.getElementById('button-filter').onclick=function(){var u='index.php?route=extension/probg_services/service&user_token={{ user_token }}';var n=document.getElementById('filter-name').value,c=document.getElementById('filter-category').value,s=document.getElementById('filter-status').value;if(n)u+='&filter_name='+encodeURIComponent(n);if(c!=='')u+='&filter_category_id='+encodeURIComponent(c);if(s!=='')u+='&filter_status='+encodeURIComponent(s);location.href=u;};</script>
{{ footer }}