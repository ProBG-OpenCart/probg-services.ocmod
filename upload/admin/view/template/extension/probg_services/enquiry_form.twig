{{ header }}{{ column_left }}
<div id="content"><div class="page-header"><div class="container-fluid"><div class="pull-right"><a href="{{ export }}" class="btn btn-info"><i class="fa fa-download"></i> {{ button_export }}</a> <a href="{{ anonymize }}" class="btn btn-warning" onclick="return confirm('{{ text_confirm_anonymize }}');"><i class="fa fa-user-secret"></i> {{ button_anonymize }}</a> <button type="submit" form="form-enquiry" class="btn btn-primary"><i class="fa fa-save"></i></button> <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
<div class="container-fluid">{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}<ul class="nav nav-tabs"><li><a href="{{ settings_url }}">{{ text_settings }}</a></li><li><a href="{{ categories_url }}">{{ text_categories }}</a></li><li><a href="{{ services_url }}">{{ text_services }}</a></li><li class="active"><a href="{{ enquiries_url }}">{{ text_enquiries }}</a></li></ul>
<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-envelope"></i> {{ text_form }}</h3></div><div class="panel-body"><div class="row"><div class="col-md-6"><table class="table table-bordered"><tr><th>{{ entry_name }}</th><td>{{ enquiry.name }}</td></tr><tr><th>{{ entry_email }}</th><td>{% if enquiry.email %}<a href="mailto:{{ enquiry.email }}">{{ enquiry.email }}</a>{% endif %}</td></tr><tr><th>{{ entry_telephone }}</th><td>{{ enquiry.telephone }}</td></tr><tr><th>{{ entry_company }}</th><td>{{ enquiry.company }}</td></tr><tr><th>{{ entry_service }}</th><td>{{ enquiry.service_name }} (#{{ enquiry.service_id }})</td></tr><tr><th>{{ entry_status }}</th><td>{{ status_name }}</td></tr><tr><th>{{ entry_assigned_user }}</th><td>{{ enquiry.assigned_user ?: text_unassigned }}</td></tr><tr><th>{{ entry_email_sent }}</th><td>{{ enquiry.email_sent ? text_yes : text_no }}</td></tr><tr><th>{{ entry_ip }}</th><td>{{ enquiry.ip }}</td></tr></table></div><div class="col-md-6"><table class="table table-bordered"><tr><th>{{ entry_subject }}</th><td>{{ enquiry.subject }}</td></tr><tr><th>{{ entry_budget }}</th><td>{{ enquiry.budget }}</td></tr><tr><th>{{ entry_deadline }}</th><td>{{ enquiry.desired_deadline }}</td></tr><tr><th>{{ entry_message }}</th><td style="white-space:pre-wrap">{{ enquiry.message }}</td></tr></table></div></div>
{% if files %}<h3>{{ text_files }}</h3><table class="table table-bordered"><tbody>{% for file in files %}<tr><td>{{ file.name }}</td><td>{{ file.mime_type }}</td><td>{{ file.size }}</td><td class="text-right"><a href="{{ file.download }}" class="btn btn-default"><i class="fa fa-download"></i> {{ button_download }}</a></td></tr>{% endfor %}</tbody></table>{% endif %}
<form action="{{ action }}" method="post" id="form-enquiry" class="form-horizontal"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_assigned_user }}</label><div class="col-sm-10"><select name="assigned_user_id" class="form-control"><option value="0">{{ text_unassigned }}</option>{% for user in users %}<option value="{{ user.user_id }}"{% if enquiry.assigned_user_id == user.user_id %} selected{% endif %}>{{ user.firstname }} {{ user.lastname }} ({{ user.username }})</option>{% endfor %}</select></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="status_id" class="form-control">{% for status in statuses %}<option value="{{ status.status_id }}"{% if enquiry.status_id == status.status_id %} selected{% endif %}>{{ status.name }}</option>{% endfor %}</select></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_comment }}</label><div class="col-sm-10"><textarea name="comment" rows="5" class="form-control"></textarea><label class="checkbox-inline"><input type="checkbox" name="notify" value="1"> {{ entry_notify_customer }}</label><p class="help-block">{{ help_notify_customer }}</p></div></div></form>
<h3>{{ text_history }}</h3><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>{{ entry_status }}</th><th>{{ entry_comment }}</th><th>{{ column_user }}</th><th>{{ column_notify }}</th><th>{{ column_date_added }}</th></tr></thead><tbody>{% if history %}{% for item in history %}<tr><td>{{ item.status_name }}</td><td>{{ item.comment }}</td><td>{{ item.user_name }}</td><td>{{ item.notify ? text_yes : text_no }}</td><td>{{ item.date_added }}</td></tr>{% endfor %}{% else %}<tr><td colspan="5" class="text-center">{{ text_no_results }}</td></tr>{% endif %}</tbody></table></div></div></div></div></div>{{ footer }}