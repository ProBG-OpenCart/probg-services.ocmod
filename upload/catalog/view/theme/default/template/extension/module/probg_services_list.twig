{{ header }}
<div id="probg-services" class="container">
  <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}{% set class='col-sm-6' %}{% elseif column_left or column_right %}{% set class='col-sm-9' %}{% else %}{% set class='col-sm-12' %}{% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      {% if categories %}<div class="row">{% for category in categories %}<div class="col-sm-6 col-md-4"><div class="card mb-3"><div class="card-body"><h3><a href="{{ category.href }}">{{ category.name }}</a></h3>{% if category.subtitle %}<p class="text-muted">{{ category.subtitle }}</p>{% endif %}{% if category.description %}<p>{{ category.description }}</p>{% endif %}<small>{{ category.count }}</small></div></div></div>{% endfor %}</div>{% endif %}
      {% if services %}<div class="row">{% for service in services %}<div class="col-sm-6 col-md-4"><div class="card h-100 mb-3">{% if service.image %}<a href="{{ service.href }}"><img src="{{ service.image }}" alt="{{ service.name }}" class="img-responsive card-img-top"></a>{% endif %}<div class="card-body"><h3><a href="{{ service.href }}">{{ service.name }}</a></h3>{% if service.subtitle %}<p class="text-muted">{{ service.subtitle }}</p>{% endif %}<p>{{ service.description }}</p>{% if service.price %}<p><strong>{{ service.price_text }} {{ service.price }}</strong></p>{% endif %}<a href="{{ service.href }}" class="btn btn-primary">{{ text_read_more }}</a></div></div></div>{% endfor %}</div>{% else %}<p>{{ text_no_results }}</p>{% endif %}
      <div class="row"><div class="col-sm-6">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div>
      {{ content_bottom }}
    </div>{{ column_right }}
  </div>
</div>
{{ footer }}
