{% if services %}
<div class="probg-services-module">
  {% if heading_title %}<h3>{{ heading_title }}</h3>{% endif %}
  <div class="row">
    {% for service in services %}
    <div class="col-sm-6 col-md-3">
      <div class="card h-100 mb-3">
        {% if service.image %}<a href="{{ service.href }}"><img src="{{ service.image }}" alt="{{ service.name }}" class="img-responsive card-img-top"></a>{% endif %}
        <div class="card-body">
          <h4 class="card-title"><a href="{{ service.href }}">{{ service.name }}</a></h4>
          {% if service.subtitle %}<p class="text-muted">{{ service.subtitle }}</p>{% endif %}
          {% if service.description %}<p>{{ service.description }}</p>{% endif %}
          {% if service.price %}<p><strong>{{ service.price_text }} {{ service.price }}</strong></p>{% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% if services_url %}<p><a href="{{ services_url }}">{{ heading_title }}</a></p>{% endif %}
</div>
{% endif %}
