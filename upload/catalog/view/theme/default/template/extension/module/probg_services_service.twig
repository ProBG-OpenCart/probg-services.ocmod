{{ header }}
<div id="probg-service" class="container">
  <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}{% set class='col-sm-6' %}{% elseif column_left or column_right %}{% set class='col-sm-9' %}{% else %}{% set class='col-sm-12' %}{% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      {% if subtitle %}<p class="lead">{{ subtitle }}</p>{% endif %}
      {% if image %}<p><img src="{{ image }}" alt="{{ heading_title }}" class="img-responsive"></p>{% endif %}
      {% if short_description %}<div class="lead">{{ short_description }}</div>{% endif %}
      {% if price %}<p class="h3">{{ price_text }} {{ price }}</p>{% endif %}
      <div class="probg-service-description">{{ description }}</div>
      {% if images %}<div class="row probg-service-gallery">{% for image in images %}<div class="col-xs-6 col-sm-4"><a href="{{ image.popup }}" target="_blank"><img src="{{ image.thumb }}" alt="{{ heading_title }}" class="img-responsive img-thumbnail"></a></div>{% endfor %}</div>{% endif %}
      {% if enquiry_status %}<p class="probg-service-enquiry"><button type="button" class="btn btn-primary" data-service-enquiry="1">{{ button_text }}</button></p>{% endif %}
      {% if related %}<h2>{{ text_related }}</h2><div class="row">{% for service in related %}<div class="col-sm-6 col-md-4"><div class="card mb-3">{% if service.image %}<a href="{{ service.href }}"><img src="{{ service.image }}" alt="{{ service.name }}" class="img-responsive"></a>{% endif %}<div class="card-body"><h3><a href="{{ service.href }}">{{ service.name }}</a></h3><p>{{ service.description }}</p></div></div></div>{% endfor %}</div>{% endif %}
      {{ content_bottom }}
    </div>{{ column_right }}
  </div>
</div>
{{ footer }}
