{{ header }}
<div id="probg-service" class="container">
  <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}{% set class='col-sm-6' %}{% elseif column_left or column_right %}{% set class='col-sm-9' %}{% else %}{% set class='col-sm-12' %}{% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      {% if subtitle %}<p class="lead">{{ subtitle }}</p>{% endif %}
      {% if image %}<p><img src="{{ image }}" alt="{{ heading_title }}" class="img-responsive"></p>{% endif %}
      {% if short_description %}<div class="lead">{{ short_description }}</div>{% endif %}
      {% if price %}<p class="h3">{{ price_text }} {{ price }}</p>{% endif %}
      <div class="probg-service-description">{{ description }}</div>

      {% if images %}
      <div class="row probg-service-gallery">
        {% for image in images %}<div class="col-xs-6 col-sm-4"><a href="{{ image.popup }}" target="_blank"><img src="{{ image.thumb }}" alt="{{ heading_title }}" class="img-responsive img-thumbnail"></a></div>{% endfor %}
      </div>
      {% endif %}

      {% if enquiry_status %}
      <section id="service-enquiry" class="probg-service-enquiry well">
        <h2>{{ text_enquiry_title }}</h2>
        {% if enquiry_success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ enquiry_success }}</div>{% endif %}
        {% if enquiry_errors.warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ enquiry_errors.warning }}</div>{% endif %}
        <form action="{{ enquiry_action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
          <input type="hidden" name="service_id" value="{{ service_id|default(0) }}">
          <div style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true"><label>Website confirmation<input type="text" name="website_confirm" value="" tabindex="-1" autocomplete="off"></label></div>

          <div class="form-group required"><label class="col-sm-3 control-label">{{ entry_name }}</label><div class="col-sm-9"><input type="text" name="name" value="{{ enquiry_data.name }}" class="form-control">{% if enquiry_errors.name %}<div class="text-danger">{{ enquiry_errors.name }}</div>{% endif %}</div></div>
          <div class="form-group required"><label class="col-sm-3 control-label">{{ entry_email }}</label><div class="col-sm-9"><input type="email" name="email" value="{{ enquiry_data.email }}" class="form-control">{% if enquiry_errors.email %}<div class="text-danger">{{ enquiry_errors.email }}</div>{% endif %}</div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_telephone }}</label><div class="col-sm-9"><input type="text" name="telephone" value="{{ enquiry_data.telephone }}" class="form-control"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_company }}</label><div class="col-sm-9"><input type="text" name="company" value="{{ enquiry_data.company }}" class="form-control"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_website }}</label><div class="col-sm-9"><input type="url" name="website" value="{{ enquiry_data.website }}" class="form-control"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_subject }}</label><div class="col-sm-9"><input type="text" name="subject" value="{{ enquiry_data.subject }}" class="form-control"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_budget }}</label><div class="col-sm-9"><input type="text" name="budget" value="{{ enquiry_data.budget }}" class="form-control"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_desired_deadline }}</label><div class="col-sm-9"><input type="text" name="desired_deadline" value="{{ enquiry_data.desired_deadline }}" class="form-control"></div></div>
          <div class="form-group required"><label class="col-sm-3 control-label">{{ entry_message }}</label><div class="col-sm-9"><textarea name="message" rows="6" class="form-control">{{ enquiry_data.message }}</textarea>{% if enquiry_errors.message %}<div class="text-danger">{{ enquiry_errors.message }}</div>{% endif %}</div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_attachments }}</label><div class="col-sm-9"><input type="file" name="attachments[]" multiple class="form-control"><p class="help-block">{{ help_attachments }}</p></div></div>
          {% if captcha %}<div class="form-group"><div class="col-sm-offset-3 col-sm-9">{{ captcha }}{% if enquiry_errors.captcha %}<div class="text-danger">{{ enquiry_errors.captcha }}</div>{% endif %}</div></div>{% endif %}
          <div class="form-group required"><div class="col-sm-offset-3 col-sm-9"><label><input type="checkbox" name="privacy" value="1"{% if enquiry_data.privacy %} checked{% endif %}> {{ entry_privacy }}</label>{% if enquiry_errors.privacy %}<div class="text-danger">{{ enquiry_errors.privacy }}</div>{% endif %}</div></div>
          <div class="form-group"><div class="col-sm-offset-3 col-sm-9"><button type="submit" class="btn btn-primary">{{ button_submit_enquiry }}</button></div></div>
        </form>
      </section>
      {% endif %}

      {% if related %}
      <h2>{{ text_related }}</h2>
      <div class="row">{% for service in related %}<div class="col-sm-6 col-md-4"><div class="card mb-3">{% if service.image %}<a href="{{ service.href }}"><img src="{{ service.image }}" alt="{{ service.name }}" class="img-responsive"></a>{% endif %}<div class="card-body"><h3><a href="{{ service.href }}">{{ service.name }}</a></h3><p>{{ service.description }}</p></div></div></div>{% endfor %}</div>
      {% endif %}
      {{ content_bottom }}
    </div>{{ column_right }}
  </div>
</div>
{{ footer }}
