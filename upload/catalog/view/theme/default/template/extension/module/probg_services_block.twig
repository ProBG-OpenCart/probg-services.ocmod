{% if services %}<section class="probg-services-block"><h3>{{ heading_title }}</h3><div class="row">{% for service in services %}<div class="product-layout col-lg-3 col-md-4 col-sm-6 col-xs-12"><div class="product-thumb transition">{% if service.image %}<div class="image"><a href="{{ service.href }}"><img src="{{ service.image }}" alt="{{ service.name }}" class="img-responsive"></a></div>{% endif %}<div class="caption"><h4><a href="{{ service.href }}">{{ service.name }}</a></h4>{% if service.subtitle %}<p><strong>{{ service.subtitle }}</strong></p>{% endif %}{% if service.description %}<p>{{ service.description }}</p>{% endif %}{% if service.price %}<p class="price">{% if service.price_text %}{{ service.price_text }} {% endif %}{{ service.price }}</p>{% endif %}</div></div></div>{% endfor %}</div></section>{% endif %}