{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-probg-services" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol>
    </div>
  </div>
  <div class="container-fluid">
    <div id="alert"></div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-briefcase"></i> {{ text_edit }}</div>
      <div class="card-body">
        <div class="alert alert-info">{{ text_info }}</div>
        <form id="form-probg-services" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_probg_services_status" value="0"><input type="checkbox" name="module_probg_services_status" value="1" class="form-check-input"{% if module_probg_services_status %} checked{% endif %}></div></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_cache_status }}</label>
            <div class="col-sm-10"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_probg_services_cache_status" value="0"><input type="checkbox" name="module_probg_services_cache_status" value="1" class="form-check-input"{% if module_probg_services_cache_status %} checked{% endif %}></div></div>
          </div>
          <div class="row mb-3">
            <label for="input-limit" class="col-sm-2 col-form-label">{{ entry_limit }}</label>
            <div class="col-sm-10"><input type="number" name="module_probg_services_limit" value="{{ module_probg_services_limit }}" min="1" max="100" id="input-limit" class="form-control"></div>
          </div>
        </form>
        <hr>
        <dl class="row mb-0">
          <dt class="col-sm-2">{{ text_version }}</dt><dd class="col-sm-10">{{ version }}</dd>
          <dt class="col-sm-2">{{ text_stage_label }}</dt><dd class="col-sm-10">{{ stage }}</dd>
        </dl>
      </div>
    </div>
  </div>
</div>
{{ footer }}
