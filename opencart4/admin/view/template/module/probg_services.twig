{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-briefcase"></i> {{ heading_title }}</div>
      <div class="card-body">
        <div class="alert alert-info">{{ text_info }}</div>
        <dl class="row mb-0">
          <dt class="col-sm-2">{{ text_version }}</dt><dd class="col-sm-10">{{ version }}</dd>
          <dt class="col-sm-2">{{ text_stage_label }}</dt><dd class="col-sm-10">{{ stage }}</dd>
        </dl>
      </div>
    </div>
  </div>
</div>
{{ footer }}
