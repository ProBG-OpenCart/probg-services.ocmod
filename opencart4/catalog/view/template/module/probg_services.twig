<section class="probg-services">
  <h2>{{ heading_title }}</h2>

  {% if categories %}
    <div class="mb-4">
      <h3 class="h5">{{ text_categories }}</h3>
      <div class="d-flex flex-wrap gap-2">
        {% for category in categories %}
          <span class="badge text-bg-light">{{ category.name }}</span>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <h3 class="h5">{{ text_services }}</h3>
  {% if services %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
      {% for service in services %}
        <div class="col">
          <article class="card h-100">
            <div class="card-body">
              <h4 class="h5 card-title">{{ service.name }}</h4>
              {% if service.subtitle %}<p class="text-muted">{{ service.subtitle }}</p>{% endif %}
              {% if service.description_short %}<div class="card-text">{{ service.description_short }}</div>{% endif %}
              {% if service.show_price and service.price %}<p class="fw-semibold mt-3 mb-0">{{ service.price_text ? service.price_text ~ ' ' : '' }}{{ service.price }}</p>{% endif %}
            </div>
          </article>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p>{{ text_empty }}</p>
  {% endif %}
</section>
